# Copy this file to tmp/development.env and replace every empty value.
# GITHUB_VAR_ and GITHUB_SECRET_ are routing prefixes; the script removes them.
GITHUB_ENVIRONMENT=development-admin

GITHUB_VAR_AUTH_BFF_BASE_URL=https://api-dev.billme.sh/api/v1/auth/admin
GITHUB_VAR_API_BASE_URL=https://api-dev.billme.sh/api/v1
GITHUB_VAR_ADMIN_PUBLIC_URL=https://admin-dev.billme.sh
GITHUB_VAR_CF_ADMIN_PROJECT_NAME=

GITHUB_SECRET_CLOUDFLARE_ACCOUNT_ID=
GITHUB_SECRET_CLOUDFLARE_API_TOKEN=
