# Proposed local-development reverse proxy for the Billmesh Console.
# Copy this file to the Nginx servers directory; do not place certificates in
# the repository. Adjust /opt/homebrew if Nginx uses a different prefix.

server {
    listen 443 ssl;
    server_name console-local.billme.sh;

    ssl_certificate     /opt/homebrew/etc/nginx/ssl/local.billme.sh.pem;
    ssl_certificate_key /opt/homebrew/etc/nginx/ssl/local.billme.sh-key.pem;

    # Razorpay Standard Checkout is allowed only in the customer Console.
    # Keep the Admin policy separate so Checkout cannot load there.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com; frame-src https://api.razorpay.com; connect-src 'self' https://api.razorpay.com wss://console-local.billme.sh; img-src 'self' data: https://checkout.razorpay.com https://api.razorpay.com https://cdn.razorpay.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    location / {
        proxy_pass http://127.0.0.1:5200;
        proxy_http_version 1.1;
        proxy_buffering off;

        # Angular's development server expects its direct local host.
        proxy_set_header Host              localhost;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Proto https;

        # Preserve the Angular development server's live-reload connection.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name console-local.billme.sh;
    return 301 https://$host$request_uri;
}
